# Web uygulamasinin tam adresi. Birden fazla adres virgul ile ayrilabilir.
WEB_ORIGIN=http://localhost:3000

# Frontend ve API farkli alan adlarindaysa true olmalidir.
CROSS_ORIGIN_COOKIES=false

# Kalici SQLite diskinin baglandigi klasor.
DATA_DIR=./data

# Vite frontend'in API sunucusu. Yerelde bos birakilir.
VITE_API_BASE_URL=

# Canli alan adinda passkey kullanimi icin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
