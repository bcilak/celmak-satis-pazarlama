# Çelmak Sipariş Yönetimi — üretim ortam değişkenleri
# Bu dosyayı sunucuda /etc/celmak/celmak.env olarak kopyalayıp değerleri doldurun.
# systemd servisi bu dosyayı EnvironmentFile olarak okur. Dosyayı gizli tutun:
#   chmod 600 /etc/celmak/celmak.env

# Üretim modu: Secure çerezleri açar, geliştirme kullanıcı-bypass'ını kapatır.
NODE_ENV=production

# Uygulamanın dinleyeceği yerel port (Nginx buraya reverse proxy yapar).
PORT=3001

# SQLite veritabanının yaşayacağı kalıcı dizin. Yedeklenebilir bir yol seçin.
DATA_DIR=/var/lib/celmak/data

# Alan adınız (HTTPS zorunlu — passkey ve Secure çerez bunu gerektirir).
WEBAUTHN_RP_ID=celmak.ornekalanadi.com
WEBAUTHN_ORIGIN=https://celmak.ornekalanadi.com
WEB_ORIGIN=https://celmak.ornekalanadi.com

# Arayüz ile API aynı sunucudan yayınlandığı için istemci göreli /api kullanır;
# VITE_API_BASE_URL BOŞ bırakılır (burada tanımlamayın). Ayrı bir alan adından
# yayın yapacaksanız derleme öncesi .env dosyasında tanımlanmalı ve
# CROSS_ORIGIN_COOKIES=true eklenmelidir.
